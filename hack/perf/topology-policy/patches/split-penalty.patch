+#[tokio::test(start_paused = true)]
+async fn direct_commits_that_a_median_split_puts_in_two_leaves_are_the_split_penalty() {
+    let backend = slow_mem();
+    let (policy, windows) = Recording::new(|_: &TopologyWindow| Vec::new());
+    let db = open(&backend, NodeSizePolicy::default(), policy).await;
+    let coll = create_top(&db, b"penalty").await;
+    write_keys(&coll, 8).await;
+    let split_penalty = || db.stats().restructurer.avoidable.split_penalty;
+
+    write_together(&db, &coll, &[&[0], &[1]], 1).await;
+    coll.write(&[3], &write_int(1)).await.unwrap();
+    assert_eq!(split_penalty(), Duration::ZERO);
+
+    write_together(&db, &coll, &[&[3], &[4]], 1).await;
+    assert!(split_penalty() > Duration::ZERO);
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    db.shutdown().await;
+    let windows = windows.lock().unwrap();
+    assert!(windows.iter().any(|window| {
+        window
+            .leaves
+            .values()
+            .any(|leaf| leaf.split_penalty > Duration::ZERO)
+    }));
+}
