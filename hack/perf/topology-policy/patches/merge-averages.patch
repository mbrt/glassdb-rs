+impl Averages {
+    /// Decays all averages by `factor`, and forgets the negligible ones.
+    fn decay(&mut self, factor: f64) {
+        self.leaves.retain(|_, net| {
+            net.decay(factor);
+            !net.is_negligible()
+        });
+        self.pairs.retain(|_, time| {
+            *time *= factor;
+            *time >= NEGLIGIBLE
+        });
+    }
+
+    /// Returns the split-side time in seconds that a merge of the leaf into
+    /// its neighbor would bring back.
+    fn split_side(&self, id: &LeafId) -> f64 {
+        // A negative net time tells that a split would hurt, not that a merge
+        // would help.
+        self.leaves.get(id).map_or(0.0, |net| net.total.max(0.0))
+    }
+}
